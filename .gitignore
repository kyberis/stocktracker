# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
e2e-*.log
e2e-*.txt
e2e-*.png
import-error.png

# private business docs (not for public repo)
docs/private/
docs/COMMERCIALIZATION_PLAN.md
docs/AD_CAMPAIGN_LAUNCH_PLAN.md
docs/AD_CREATIVES.md
docs/ad-creatives-gallery.html
docs/CONVERSION_EVENTS.md
docs/SUPPLIER_OUTREACH_EMAILS.md
docs/SECURITY_AUDIT.md
docs/competitive-analysis.html
docs/competitor-value-comparison-report.html
docs/cost-vs-revenue.html
docs/X_ACCOUNT_PLAYBOOK.md
docs/SOCIAL_MEDIA_POSTS.md
docs/LAUNCH_COPY.md
docs/linkedin-series-trefolio.md

# cursor debug logs
.cursor/debug*.log

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# locale fill script cache (OpenAI gap translations)
scripts/.locale-fill-cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.local.example

# sqlite runtime data
*.db
data/*.db
data/*.db-*

# promo assets (screenshots & video)
promo-screenshots/
promo-video.mp4

# capacitor native build artifacts
ios/App/Pods/
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/

# vercel
.vercel

# external submodules (Clara/etracker) — submodule files tracked via .gitmodules,
# but artifacts/deps inside the submodule must never leak into trefolio's tree
external/**/node_modules
external/**/.next
external/**/.env*
!external/**/.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
