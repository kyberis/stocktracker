# ----- trefolio-accounts (IdP) ------------------------------------------------
# After the IdP cutover, Clara delegates auth to user.trefolio.com.
# See knowledge/design-docs/clara-idp-integration.md (in trefolio repo).

IDP_BASE_URL=https://user.trefolio.com
IDP_CLIENT_ID=clara
IDP_CLIENT_SECRET=
IDP_SERVICE_TOKEN=

# Feature flag during the migration window. Default true; set "false" after
# every existing Clara user has been backfilled into the IdP.
USE_LEGACY_AUTH=true
