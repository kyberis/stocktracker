-}
+async function findUserByTelegramId(tgUserId: number) {
+  // Try local cache first (avoids IdP round-trip on every message).
+  const local = await db.user.findUnique({ where: { telegramUserId: BigInt(tgUserId) } });
+  if (local) return local;
+  // Cache miss: ask the IdP, then upsert locally.
+  try {
+    const lookup = await fetchUserByTelegramId(tgUserId);
+    return db.user.findUnique({ where: { idpSub: lookup.sub } });
+  } catch (err) {
+    if (err instanceof IdpClientError && err.status === 404) return null;
+    throw err;
+  }
+}
