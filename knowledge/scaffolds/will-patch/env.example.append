# ----- trefolio-accounts (IdP) ------------------------------------------------
# After the IdP cutover, Will delegates auth to user.trefolio.com.
# See knowledge/design-docs/will-idp-integration.md (in trefolio repo).

IDP_BASE_URL=https://user.trefolio.com
IDP_CLIENT_ID=will
IDP_CLIENT_SECRET=
IDP_SERVICE_TOKEN=

# When IDP_BASE_URL, IDP_CLIENT_ID, and IDP_CLIENT_SECRET are all set, /login and
# /register use the unified IdP (bridge UI). Omit IDP_CLIENT_SECRET locally only
# if you still need the legacy email/password (+ optional Google) forms.
