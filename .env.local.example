# --------------------------------------------------
# StockTracker – Environment Variables
# --------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel, configure these in Settings → Environment Variables.

# ----- Database (Turso) -----
# `next dev` and Vitest ignore remote Turso URL unless you opt in (see below), and
# use a local file: data/trefolio.db — so production Turso creds in .env.local
# never hit prod data by accident.
# Leave Turso vars unset to use only local SQLite.
# Set both for Turso (required on Vercel; optional locally for staging DB / `next start`).
STOCKTRACKER_TURSO_DATABASE_URL=
STOCKTRACKER_TURSO_AUTH_TOKEN=
# Optional: allow `next dev` / tests to use the Turso URL above (e.g. a dev branch DB).
# TREFOLIO_USE_REMOTE_DB_IN_DEV=true
# STOCKTRACKER_USE_REMOTE_DB_IN_DEV=true

# ----- Session -----
# Secret used to sign JWT session tokens.
# Generate one with: openssl rand -hex 32
# REQUIRED in production. Falls back to a dev-only default locally.
APP_SESSION_SECRET=

# ----- Alpha Vantage (premium market data) -----
# API key for Alpha Vantage — used for Pro users' market data, economic
# indicators, fundamentals, and ex-dividend calendar.
# Get a free key at https://www.alphavantage.co/support/#api-key
# Can also be configured in the Admin panel; env var takes precedence.
STOCKTRACKER_ALPHAVANTAGE_API_KEY=

# ----- Financial Modeling Prep (premium market data + MCP proxy) -----
# Server-side key for FMP stable API (fundamentals, calendars, MCP fmpRequest, etc.).
# https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# ----- Vercel AI Gateway (Warren, portfolio AI, imports, digests, audio) -----
# Preferred auth for all LLM and OpenAI-compatible audio endpoints.
# Create a key in Vercel → AI Gateway. On Vercel, incoming requests include
# `x-vercel-oidc-token` for Gateway auth when neither AI_GATEWAY_API_KEY nor legacy env keys are set.
# Legacy env name `STOCKTRACKER_OPENAI_API_KEY` still resolves as a bearer token fallback.
AI_GATEWAY_API_KEY=
# Optional: present after `vercel env pull` for local dev against Gateway.
# VERCEL_OIDC_TOKEN=
STOCKTRACKER_OPENAI_API_KEY=

# ----- Billing (Stripe) -----
# Stripe secret key for server-side API calls.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs for Starter (Bifolio) subscriptions.
# Create in Stripe: €2.99/mo (launch), regular €3.99/mo.
STRIPE_PRICE_STARTER_MONTHLY=
# Create in Stripe: €23.99/yr (launch), regular €31.99/yr.
STRIPE_PRICE_STARTER_ANNUAL=

# Stripe price IDs for Pro (Trefolio) subscriptions.
# Create in Stripe: €7.99/mo (launch), regular €9.99/mo.
STRIPE_PRICE_PRO_MONTHLY=
# Create in Stripe: €59.99/yr (launch), regular €79.99/yr.
STRIPE_PRICE_PRO_ANNUAL=

# Stripe coupon ID for device-linked 1-year free Pro.
# Create in Stripe Dashboard: 100% off, repeating, 12 months.
STRIPE_COUPON_DEVICE_FREE_YEAR=

# Public app base URL used for checkout/portal redirects.
# Example: http://localhost:3000
APP_BASE_URL=

# ----- Google Analytics 4 -----
# GA4 Measurement ID for client-side analytics (consent-gated).
# Get yours at https://analytics.google.com → Admin → Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----- Google Ads -----
# Google Ads Conversion ID for conversion tracking (consent-gated).
# Get yours at https://ads.google.com → Tools → Conversions → Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ----- Google OAuth -----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Apple OAuth -----
# Configure at https://developer.apple.com under Certificates, Identifiers & Profiles
# Authorized redirect URI: {APP_BASE_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ----- Monitoring (Grafana) -----
# URL to your local Grafana instance (Docker Compose dev stack).
# Start the monitoring stack with: docker compose -f docker-compose.monitoring.yml up -d
GRAFANA_URL=http://localhost:3001

# ----- Monitoring (Grafana Cloud) -----
# Push metrics to Grafana Cloud for production / Vercel deployments.
# Sign up at https://grafana.com (free tier), go to Connections > OTLP,
# and copy the endpoint, instance ID, and generate an API token.
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# Direct link to your Grafana Cloud dashboard (shown in the admin panel).
GRAFANA_CLOUD_DASHBOARD_URL=

# ----- Rate Limiting (Upstash Redis) -----
# Create a free Redis database at https://console.upstash.com
# Required on Vercel for fast rate limiting. Falls back to Turso locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Email (Resend) -----
# API key from https://resend.com — used for email verification and price alerts.
# Free tier: 3,000 emails/month.
RESEND_API_KEY=
# "From" address for emails (must be a verified domain in Resend).
RESEND_FROM_ADDRESS=StockTracker <noreply@stocktracker.eu>

# ----- CAPTCHA (Cloudflare Turnstile) -----
# Protects signup/login from bots. Get keys at https://dash.cloudflare.com/turnstile
# CAPTCHA is automatically skipped during `next dev`, on localhost/127.0.0.1
# (including local `npm start`), and whenever TURNSTILE_DISABLED=1 is set.
# Set NEXT_PUBLIC_TURNSTILE_DISABLED=1 to also hide the widget on the client.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_DISABLED=1
# NEXT_PUBLIC_TURNSTILE_DISABLED=1

# ----- SnapTrade (brokerage aggregator, Pro-only) -----
# API credentials from https://dashboard.snaptrade.com/api-key
# Connects to 20+ brokerages (Robinhood, Questrade, Wealthsimple, etc.)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ----- Finnhub (free news fallback) -----
# Free API key from https://finnhub.io — used as a news fallback when
# Alpha Vantage is unavailable or returns no results.
FINNHUB_API_KEY=

# ----- Cron Auth -----
# Secret used by Vercel Cron to authenticate /api/cron/* endpoints.
# Required on Vercel production and preview; omit locally only if you call cron without auth.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ----- Linear (feedback pipeline) -----
# Personal API key and team UUID from https://linear.app/settings/api
# Used by /api/cron/feedback-pipeline to create issues from user feedback.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Signing secret from the webhook detail page (Settings → API → Webhooks).
LINEAR_WEBHOOK_SECRET=

# ----- Telegram Alerts (Bot API) -----
# Create a bot with @BotFather. Set webhook URL to https://YOUR_DOMAIN/api/webhooks/telegram
# and optionally pass the same secret as secret_token (verified via X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_BOT_TOKEN=
# Username without @ (used for Profile → Notifications deep links)
TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# ----- Web Push Notifications (VAPID) -----
# VAPID keys for Chrome/Firefox push notifications (Starter+ feature).
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@trefolio.com

# ----- Firmware OTA (T4-S3 Device) -----
# Set these when releasing a new firmware version for the LILYGO T4-S3 device.
# The device checks GET /api/device/firmware for updates on boot + every 6 hours.
# See docs/FIRMWARE_OTA_GUIDE.md for the full release process.
# Leave empty to disable OTA updates (devices will see "no update available").
FIRMWARE_LATEST_VERSION=
FIRMWARE_LATEST_URL=
FIRMWARE_LATEST_SHA256=
FIRMWARE_LATEST_SIZE=
FIRMWARE_LATEST_NOTES=
# Percentage of devices that should receive the update (0-100, default 100).
# Uses deterministic hashing per user ID so the same device always gets a
# consistent answer. Increase gradually: 10 → 25 → 50 → 100.
FIRMWARE_ROLLOUT_PERCENT=100

# ----- Digest emails (optional) -----
# Set to 1 to block admin "send to all users" for market digests. Users read
# digests in-app at /daily-digests instead.
# MARKET_DIGEST_EMAIL_BROADCAST_DISABLED=1
#
# Set to 1 to skip the weekly AI portfolio digest email (cron + admin test).
# Digests are still generated and shown on the dashboard.
# WEEKLY_DIGEST_EMAIL_DISABLED=1

# ----- Telegram Bot (Warren) -----
# Bot token from BotFather (https://t.me/BotFather → /newbot).
TELEGRAM_BOT_TOKEN=
# Bot username without @ (e.g. WarrenTrefolioBot) — used to build the
# https://t.me/<username>?start=<token> deep link from /profile.
TELEGRAM_BOT_USERNAME=
# Random secret echoed in BOTH the webhook URL path AND the
# X-Telegram-Bot-Api-Secret-Token header. Generate with:
#   openssl rand -hex 32
# After setting, run: PUBLIC_BASE_URL=https://trefolio.com \
#   npx tsx scripts/telegram-set-webhook.ts
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of this deployment, used by scripts/telegram-set-webhook.ts.
# Falls back to NEXT_PUBLIC_BASE_URL if unset.
# PUBLIC_BASE_URL=https://trefolio.com

# ----- ProdOps Telegram (staff notifications) -----
# External ProdOps service base URL (for signed intake dispatch).
# Example: https://ops.trefolio.com
PRODOPS_BASE_URL=
# Shared HMAC secret used by both trefolio and external/prodops.
PRODOPS_SHARED_SECRET=
# Bot username without @ used by the admin deep-link handshake that links the
# single Telegram DM recipient for staff operational alerts.
PRODOPS_TELEGRAM_BOT_USERNAME=

# ----- Clara (etracker) — sister financial-agents service -----
# Base URL for the Clara service (kyberis/etracker). Trefolio's financial agents
# call Clara over HTTP/MCP. Clara runs as a separate Vercel project and, in local
# dev, on port **3001** (fixed in `external/etracker/package.json`; see `dev/ports.md`).
# Leave empty until trefolio actually needs to call Clara.
# See knowledge/design-docs/etracker-clara-integration.md
CLARA_BASE_URL=http://localhost:3001

# ----- Will (notetaker) — sister note-taking service -----
# Base URL for Will (kyberis/notetaker). Agent Office calls Will internal routes
# over HTTP. Will runs as a separate Vercel project and, in local dev, on port
# **3200** (see `dev/ports.md`). Leave empty until Office needs Will in prod.
# See knowledge/design-docs/notetaker-will-integration.md
WILL_BASE_URL=http://localhost:3200

# ----- AID (Advanced Investor Dashboard) — optional web search for earnings digests -----
# Tavily API key for Warren/aid news web search on earnings days. Without it, digests
# use cached provider news only. Get a key at https://tavily.com
# TAVILY_API_KEY=

# ----- trefolio-accounts (IdP) — unified identity + billing -----
# Base URL of the IdP. Override only for local dev. In production builds,
# the code falls back to https://user.trefolio.com automatically when this
# is unset (see src/lib/idp/config.ts::getIdpBaseUrl), so deploys "just
# work" without manually setting it on Vercel. For local dev, point this
# at the in-repo IdP. For the HTTPS proxy stack (`dev/README.md`), **prefer**
# `http://localhost:3300` for trefolio's `IDP_BASE_URL` so Node can reach the
# token/JWKS endpoints without trusting Caddy's local CA. Set **`IDP_ISSUER`**
# to the browser-facing origin when using the HTTPS proxy stack so authorize
# redirects go to `https://user.trefolio-dev.com` (see `dev/README.md`).
# IDP_BASE_URL=http://localhost:3300
# IDP_ISSUER=https://user.trefolio-dev.com
# See knowledge/design-docs/unified-accounts-and-billing.md.
#
# Vercel (trefolio project) — set these for production/staging OIDC login:
#   IDP_BASE_URL=https://user.trefolio.com
#   IDP_CLIENT_ID=trefolio
#   IDP_CLIENT_SECRET=(same value as IdP project env IDP_CLIENT_SECRET_TREFOLIO)
#   IDP_SERVICE_TOKEN=(shared with IdP for /v1/* and trefolio /api/v1/users/by-sub/*)
# Optional prod: IDP_ISSUER if it differs from IDP_BASE_URL (usually omit).
# Preview deployments: each preview origin needs its /api/auth/oidc/callback URL
# added to STATIC_CLIENTS in external/accounts/src/lib/oidc.ts (no wildcards), or
# test OIDC only against staging/production hostname.
# Print cutover order + optional env validation:
#   npm run idp:cutover-checklist
#   node --env-file=.env.local scripts/idp-cutover-checklist.mjs
IDP_BASE_URL=https://user.trefolio.com
# OAuth client_id assigned to trefolio in the IdP's static client registry.
IDP_CLIENT_ID=trefolio
# OAuth client_secret. Server-only. Never expose to the browser.
# Must match the IdP Vercel env IDP_CLIENT_SECRET_TREFOLIO (see external/accounts).
IDP_CLIENT_SECRET=
# Service token used by trefolio for /v1/* REST calls (entitlements, telegram,
# admin user import). Generate the same secret on the IdP side.
# trefolio also exposes /api/v1/users/by-sub/[sub] consumed by the IdP admin
# UI ("which users have a local trefolio account?") — same token validates it.
IDP_SERVICE_TOKEN=
# Optional: dedicated bearer for IdP `GET/PUT /api/v1/internal/ai-model-config`
# (ecosystem-wide AI model map). If unset, trefolio falls back to IDP_SERVICE_TOKEN.
# ACCOUNTS_AI_CONFIG_SECRET=
# Same value as on the IdP (user.trefolio.com) and on Clara/Will. Used for
# server-to-server `POST {IDP_ISSUER or IDP_BASE_URL}/api/v1/pat/introspect`
# when a client sends `Authorization: Bearer tfp_pat_…` to `/api/mcp/user`.
# Generate with: openssl rand -hex 32
TREFOLIO_PAT_INTROSPECTION_SECRET=
# Local password / Google / Apple / Passkey sign-in is removed when the IdP is
# configured (`IDP_BASE_URL` + client id/secret): `/login` and `/signup` use the
# unified account at user.trefolio.com. For Playwright E2E without an IdP, omit
# `IDP_CLIENT_SECRET` so `isIdpEnabled()` stays false and `/api/auth/login` works with E2E=1.
# Deprecated — unused by current code. Upgrade and billing portal URLs are
# resolved from IDP_ISSUER / IDP_BASE_URL (see src/lib/idp/config.ts).
# Left for backwards compatibility in older env dumps only.
# BILLING_REDIRECT_TO_IDP=false
# When "true", trial invitation + admin membership-grant emails point claim flows at
# user.trefolio.com; cron syncs trial tokens to the IdP before inviting; admin grants
# are sent from the IdP. Requires IDP_BASE_URL, IDP_ISSUER (browser-facing), and
# IDP_SERVICE_TOKEN aligned with the accounts deployment.
GRANTS_AND_TRIALS_REDIRECT_TO_IDP=false
# Cutover safety switch: when set to "true", legacy signup paths refuse to
# create new local users (return 503). The OIDC callback is exempt so the
# migration script can still create local rows on first IdP login.
# Used during the Phase 6 cutover window.
FREEZE_LOCAL_USER_WRITES=false
# Comma-separated emails that get `users.role = admin` in trefolio when signing in
# (OIDC or after `/api/auth/me`). If unset, falls back to IDP_ADMIN_EMAILS so the
# same list can govern both user.trefolio.com and trefolio.com admin.
# TREFOLIO_ADMIN_EMAILS=you@example.com
# IdP-only (not read by trefolio): comma-separated emails for operator admin at
# user.trefolio.com `/admin`. Set on the accounts Vercel project and in
# `external/accounts/.env.local` for local IdP (`npm run dev` in that folder).
# IDP_ADMIN_EMAILS=you@example.com
#
# IdP-only (set on the **trefolio-accounts** Vercel project / accounts `.env.local`):
#   RESEND_API_KEY, RESEND_FROM_ADDRESS — required in production for verification +
#     password-reset emails (non-prod skips send and logs reset URLs to the console).
#   IDP_SKIP_VERIFICATION_EMAIL=true — staging only; suppresses verification mail.
#   IDP_SKIP_PASSWORD_RESET_EMAIL=true — staging only; suppresses password-reset mail.
#   IDP_PASSWORD_RESET_SECRET — optional separate HS256 secret for reset JWTs.
