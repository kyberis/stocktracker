# --------------------------------------------------
# StockTracker – Environment Variables
# --------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel, configure these in Settings → Environment Variables.

# ----- Database (Turso) -----
# Leave unset for local SQLite file (data/stocktracker.db).
# Set both for Turso (required on Vercel).
STOCKTRACKER_TURSO_DATABASE_URL=
STOCKTRACKER_TURSO_AUTH_TOKEN=

# ----- Session -----
# Secret used to sign JWT session tokens.
# Generate one with: openssl rand -hex 32
# REQUIRED in production. Falls back to a dev-only default locally.
APP_SESSION_SECRET=

# ----- AI Analysis (optional, legacy) -----
# OpenAI API key — DEPRECATED: prefer configuring this in the Admin panel
# (Settings tab) where it's stored encrypted. This env var is kept only as
# a fallback; the Admin-managed key takes precedence.
# STOCKTRACKER_OPENAI_API_KEY=

# ----- Billing (Stripe) -----
# Stripe secret key for server-side API calls.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs for Pro subscriptions.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Public app base URL used for checkout/portal redirects.
# Example: http://localhost:3000
APP_BASE_URL=

# ----- Monitoring (Grafana) -----
# URL to your local Grafana instance (Docker Compose dev stack).
# Start the monitoring stack with: docker compose -f docker-compose.monitoring.yml up -d
GRAFANA_URL=http://localhost:3001

# ----- Monitoring (Grafana Cloud) -----
# Push metrics to Grafana Cloud for production / Vercel deployments.
# Sign up at https://grafana.com (free tier), go to Connections > OTLP,
# and copy the endpoint, instance ID, and generate an API token.
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# Direct link to your Grafana Cloud dashboard (shown in the admin panel).
GRAFANA_CLOUD_DASHBOARD_URL=

# ----- Rate Limiting (Upstash Redis) -----
# Create a free Redis database at https://console.upstash.com
# Required on Vercel for fast rate limiting. Falls back to Turso locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Email (Resend) -----
# API key from https://resend.com — used for email verification and price alerts.
# Free tier: 3,000 emails/month.
RESEND_API_KEY=
# "From" address for emails (must be a verified domain in Resend).
RESEND_FROM_ADDRESS=StockTracker <noreply@stocktracker.eu>

# ----- Cron Auth -----
# Secret used by Vercel Cron to authenticate /api/cron/* endpoints.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
