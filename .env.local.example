# --------------------------------------------------
# StockTracker – Environment Variables
# --------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel, configure these in Settings → Environment Variables.

# ----- Database (Turso) -----
# Leave unset for local SQLite file (data/stocktracker.db).
# Set both for Turso (required on Vercel).
STOCKTRACKER_TURSO_DATABASE_URL=
STOCKTRACKER_TURSO_AUTH_TOKEN=

# ----- Session -----
# Secret used to sign JWT session tokens.
# Generate one with: openssl rand -hex 32
# REQUIRED in production. Falls back to a dev-only default locally.
APP_SESSION_SECRET=

# ----- Alpha Vantage (premium market data) -----
# API key for Alpha Vantage — used for Pro users' market data, economic
# indicators, fundamentals, and ex-dividend calendar.
# Get a free key at https://www.alphavantage.co/support/#api-key
# Can also be configured in the Admin panel; env var takes precedence.
STOCKTRACKER_ALPHAVANTAGE_API_KEY=

# ----- OpenAI (AI analysis) -----
# API key for OpenAI — powers AI stock analysis, portfolio review,
# AI-assisted CSV import, and device summaries.
# Get a key at https://platform.openai.com/api-keys
# Can also be configured in the Admin panel; env var takes precedence.
STOCKTRACKER_OPENAI_API_KEY=

# ----- Billing (Stripe) -----
# Stripe secret key for server-side API calls.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs for Starter (Bifolio) subscriptions.
# Create in Stripe: €2.99/mo (launch), regular €3.99/mo.
STRIPE_PRICE_STARTER_MONTHLY=
# Create in Stripe: €23.99/yr (launch), regular €31.99/yr.
STRIPE_PRICE_STARTER_ANNUAL=

# Stripe price IDs for Pro (Trefolio) subscriptions.
# Create in Stripe: €7.99/mo (launch), regular €9.99/mo.
STRIPE_PRICE_PRO_MONTHLY=
# Create in Stripe: €59.99/yr (launch), regular €79.99/yr.
STRIPE_PRICE_PRO_ANNUAL=

# Stripe coupon ID for device-linked 1-year free Pro.
# Create in Stripe Dashboard: 100% off, repeating, 12 months.
STRIPE_COUPON_DEVICE_FREE_YEAR=

# Public app base URL used for checkout/portal redirects.
# Example: http://localhost:3000
APP_BASE_URL=

# ----- Google Analytics 4 -----
# GA4 Measurement ID for client-side analytics (consent-gated).
# Get yours at https://analytics.google.com → Admin → Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----- Google Ads -----
# Google Ads Conversion ID for conversion tracking (consent-gated).
# Get yours at https://ads.google.com → Tools → Conversions → Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ----- Google OAuth -----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Apple OAuth -----
# Configure at https://developer.apple.com under Certificates, Identifiers & Profiles
# Authorized redirect URI: {APP_BASE_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ----- Monitoring (Grafana) -----
# URL to your local Grafana instance (Docker Compose dev stack).
# Start the monitoring stack with: docker compose -f docker-compose.monitoring.yml up -d
GRAFANA_URL=http://localhost:3001

# ----- Monitoring (Grafana Cloud) -----
# Push metrics to Grafana Cloud for production / Vercel deployments.
# Sign up at https://grafana.com (free tier), go to Connections > OTLP,
# and copy the endpoint, instance ID, and generate an API token.
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# Direct link to your Grafana Cloud dashboard (shown in the admin panel).
GRAFANA_CLOUD_DASHBOARD_URL=

# ----- Rate Limiting (Upstash Redis) -----
# Create a free Redis database at https://console.upstash.com
# Required on Vercel for fast rate limiting. Falls back to Turso locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Email (Resend) -----
# API key from https://resend.com — used for email verification and price alerts.
# Free tier: 3,000 emails/month.
RESEND_API_KEY=
# "From" address for emails (must be a verified domain in Resend).
RESEND_FROM_ADDRESS=StockTracker <noreply@stocktracker.eu>

# ----- CAPTCHA (Cloudflare Turnstile) -----
# Protects signup/login from bots. Get keys at https://dash.cloudflare.com/turnstile
# Optional in development; when unset, CAPTCHA is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- SnapTrade (brokerage aggregator, Pro-only) -----
# API credentials from https://dashboard.snaptrade.com/api-key
# Connects to 20+ brokerages (Robinhood, Questrade, Wealthsimple, etc.)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ----- Finnhub (free news fallback) -----
# Free API key from https://finnhub.io — used as a news fallback when
# Alpha Vantage is unavailable or returns no results.
FINNHUB_API_KEY=

# ----- Cron Auth -----
# Secret used by Vercel Cron to authenticate /api/cron/* endpoints.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ----- Linear (feedback pipeline) -----
# Personal API key and team UUID from https://linear.app/settings/api
# Used by /api/cron/feedback-pipeline to create issues from user feedback.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Signing secret from the webhook detail page (Settings → API → Webhooks).
LINEAR_WEBHOOK_SECRET=

# ----- WhatsApp Alerts (Twilio) -----
# Twilio credentials for WhatsApp alert notifications (Pro feature).
# Get an account at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled Twilio phone number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+18705213951
# Twilio Verify service SID for phone number verification (format: VAxxxxxxxxxx).
# Create one at https://console.twilio.com/verify/services
# IMPORTANT: Enable the WhatsApp channel on the Verify service for production use.
TWILIO_VERIFY_SERVICE_SID=
# Verification OTP channel: "sms" or "whatsapp".
# Auto-detected if unset: sms on localhost, whatsapp in production.
# TWILIO_VERIFY_CHANNEL=sms

# ----- Web Push Notifications (VAPID) -----
# VAPID keys for Chrome/Firefox push notifications (Starter+ feature).
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@trefolio.com

# ----- Firmware OTA (T4-S3 Device) -----
# Set these when releasing a new firmware version for the LILYGO T4-S3 device.
# The device checks GET /api/device/firmware for updates on boot + every 6 hours.
# See docs/FIRMWARE_OTA_GUIDE.md for the full release process.
# Leave empty to disable OTA updates (devices will see "no update available").
FIRMWARE_LATEST_VERSION=
FIRMWARE_LATEST_URL=
FIRMWARE_LATEST_SHA256=
FIRMWARE_LATEST_SIZE=
FIRMWARE_LATEST_NOTES=
# Percentage of devices that should receive the update (0-100, default 100).
# Uses deterministic hashing per user ID so the same device always gets a
# consistent answer. Increase gradually: 10 → 25 → 50 → 100.
FIRMWARE_ROLLOUT_PERCENT=100
