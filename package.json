{
  "name": "trefolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "dev:turbo": "next dev --turbo -p 3010",
    "build": "npm run db:migrate && next build",
    "build:next": "next build",
    "start": "next start",
    "feature:guard": "node scripts/check-feature-guard.mjs",
    "feature:landing-reviewed": "node scripts/mark-landing-reviewed.mjs",
    "prepr": "node scripts/prepr.mjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "idp:migrate-users": "tsx scripts/migrate-users-to-idp.ts",
    "idp:migrate-subscriptions": "tsx scripts/migrate-trefolio-subscriptions-to-idp.ts",
    "idp:cutover-checklist": "node scripts/idp-cutover-checklist.mjs",
    "idp:migrate-all-users": "node scripts/migrate-unified-users-to-idp.mjs",
    "idp:send-unified-email": "tsx scripts/send-unified-accounts-email.ts",
    "idp:seed-legacy-admin": "tsx scripts/seed-legacy-admin.ts",
    "test": "vitest run --exclude 'src/lib/__tests__/chaos/**'",
    "test:chaos": "vitest run src/lib/__tests__/chaos",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pre-deploy": "bash scripts/pre-deploy.sh",
    "materialize:portfolio-snapshots": "bash scripts/materialize-portfolio-snapshots.sh",
    "knowledge:gen": "tsx scripts/gen-knowledge-generated.ts",
    "knowledge:lint": "tsx scripts/lint-knowledge.ts",
    "cap:dev": "CAPACITOR_SERVER_URL=http://localhost:3010 npx cap copy",
    "cap:ios": "CAPACITOR_SERVER_URL=http://localhost:3010 npx cap copy ios && npx cap open ios",
    "cap:android": "CAPACITOR_SERVER_URL=http://10.0.2.2:3010 npx cap copy android && npx cap open android",
    "cap:prod": "npx cap copy",
    "cap:run:ios": "CAPACITOR_SERVER_URL=http://localhost:3010 npx cap copy ios && npx cap run ios",
    "cap:run:android": "CAPACITOR_SERVER_URL=http://10.0.2.2:3010 npx cap copy android && npx cap run android",
    "clara:install": "npm --prefix external/etracker ci",
    "clara:update": "git submodule update --remote external/etracker",
    "prodops:install": "npm --prefix external/prodops install",
    "prodops:update": "git submodule update --remote external/prodops",
    "dev:clara": "npm --prefix external/etracker run dev",
    "dev:will": "npm --prefix external/notetaker run dev",
    "dev:accounts": "npm --prefix external/accounts run dev",
    "dev:prodops": "npm --prefix external/prodops run dev",
    "dev:all": "concurrently -n trefolio,clara -c blue,magenta \"npm run dev\" \"npm run dev:clara\"",
    "dev:ensure-env": "node scripts/ensure-unified-dev-env.mjs",
    "dev:unified": "concurrently -n trefolio,clara,will,accounts -c blue,magenta,green,yellow \"npm run dev\" \"npm run dev:clara\" \"npm run dev:will\" \"npm run dev:accounts\"",
    "dev:proxy": "bash dev/run-caddy-proxy.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.54",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kyberis/agent-os": "github:kyberis/agent-os#v0.1.0",
    "@libsql/client": "^0.17.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^9.0.3",
    "@types/bcryptjs": "^3.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^1.1.1",
    "@vercel/functions": "^2.2.13",
    "@vercel/speed-insights": "^1.3.1",
    "@xyflow/react": "^12.11.3",
    "ai": "^6.0.170",
    "bcryptjs": "^3.0.3",
    "geist": "^1.7.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "mcp-handler": "^1.1.0",
    "next": "^14.2.35",
    "pdf-parse": "^1.1.1",
    "prom-client": "^15.1.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^3.7.0",
    "resend": "^6.4.2",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "snaptrade-typescript-sdk": "^9.0.172",
    "stripe": "^22.0.1",
    "svix": "^1.88.0",
    "swr": "^2.4.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
